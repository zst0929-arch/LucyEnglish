AUTH_SECRET="replace-with-a-long-random-secret"
ACCOUNT_ENCRYPTION_KEY="replace-with-a-long-random-secret-for-payout-account-encryption"

# Admin dashboard login for /admin.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-admin-password"

# QQ Mail notification for verification codes and admin notices.
# Registration, booking, and payment notifications are sent to BOOKING_NOTIFY_TO.
# Enable SMTP in QQ Mail settings and use the generated authorization code,
# not the normal QQ login password.
QQ_SMTP_HOST="smtp.qq.com"
QQ_SMTP_PORT="465"
QQ_SMTP_USER="1521018128@qq.com"
QQ_SMTP_AUTH_CODE="replace-with-qq-mail-smtp-authorization-code"
BOOKING_NOTIFY_TO="1521018128@qq.com"

# Stripe payment channel for paid courses.
# Course checkout uses $49 USD per 1-hour lesson.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# NEXT_PUBLIC_SITE_URL="http://localhost:3001"
